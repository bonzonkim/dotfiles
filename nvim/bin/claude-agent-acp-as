#!/usr/bin/env python3
# claude-agent-acp reads the Claude Code agent name from session _meta, which codecompanion never sends
import json, os, signal, subprocess, sys, threading

agent = sys.argv[1]
child = subprocess.Popen(["claude-agent-acp", *sys.argv[2:]], stdin=subprocess.PIPE)
signal.signal(signal.SIGTERM, lambda *_: child.terminate())


def pump():
    try:
        for line in sys.stdin.buffer:
            try:
                msg = json.loads(line)
                if msg.get("method") in ("session/new", "session/load"):
                    msg["params"].setdefault("_meta", {}).setdefault("claudeCode", {}).setdefault("options", {})["agent"] = agent
                    line = (json.dumps(msg) + "\n").encode()
            except (ValueError, AttributeError, KeyError, TypeError):
                pass
            child.stdin.write(line)
            child.stdin.flush()
    except OSError:
        pass
    finally:
        try:
            child.stdin.close()
        except OSError:
            pass


threading.Thread(target=pump, daemon=True).start()
rc = child.wait()
os._exit(rc if rc >= 0 else 128 - rc)  # skip interpreter finalization: the daemon pump thread may hold the stdin lock
